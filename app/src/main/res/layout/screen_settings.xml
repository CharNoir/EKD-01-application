<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout style="@style/CardContainer">
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/backBtn" style="@style/AmberButton.Row" android:text="@string/back" />
                <Button android:id="@+id/historyBtn" style="@style/AmberButton.Row" android:layout_marginStart="8dp" android:text="@string/history_button" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/bike_title" />
            <TextView android:id="@+id/bikeNameLabel" style="@style/BodyText" tools:text="My e-bike" />
            <TextView android:id="@+id/bikeAddressLabel" style="@style/HintText" tools:text="AA:BB:CC:DD:EE:FF" />
            <Button android:id="@+id/chooseBikeBtn" style="@style/AmberButton" android:layout_width="match_parent" android:text="@string/bike_choose" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/bt_unlock_title" />
            <TextView android:id="@+id/btUnlockLabel" style="@style/BodyText" android:textSize="13sp" tools:text="BT unlock level: 1" />
            <SeekBar android:id="@+id/btUnlockSlider" style="@style/AmberSlider" android:min="1" android:max="5" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/brightness_title" />
            <TextView android:id="@+id/brightnessLabel" style="@style/BodyText" android:textSize="13sp" tools:text="Brightness: 2" />
            <SeekBar android:id="@+id/brightnessSlider" style="@style/AmberSlider" android:min="1" android:max="4" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/device_settings" />
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/unitsKmBtn" style="@style/AmberButton.Row" android:text="@string/units_km" />
                <Button android:id="@+id/unitsMiBtn" style="@style/AmberButton.Row" android:text="@string/units_mi" />
            </LinearLayout>
            <EditText android:id="@+id/autoOffInput" style="@style/StyledEditText" android:hint="@string/auto_off_hint" android:inputType="number" />
            <Button android:id="@+id/setAutoOffBtn" style="@style/AmberButton" android:layout_width="match_parent" android:text="@string/set_auto_off" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/main_screen_title" />
            <CheckBox
                android:id="@+id/showBatteryPercentCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:text="@string/show_battery_percent" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/record_title" />
            <TextView android:id="@+id/recordIntervalLabel" style="@style/BodyText" android:textSize="13sp" />
            <EditText android:id="@+id/recordIntervalInput" style="@style/StyledEditText" android:hint="@string/record_interval_hint" android:inputType="number" />
            <Button android:id="@+id/setRecordIntervalBtn" style="@style/AmberButton" android:layout_width="match_parent" android:text="@string/record_interval_set" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/background_title" />
            <CheckBox
                android:id="@+id/backgroundExecutionCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:text="@string/background_execution_enabled" />
            <TextView style="@style/HintText" android:text="@string/background_hint" />
            <Button android:id="@+id/notificationSettingsBtn" style="@style/AmberButton" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="@string/notification_settings_button" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/developer_title" />
            <Button android:id="@+id/developerNavBtn" style="@style/AmberButton" android:layout_width="match_parent" android:text="@string/developer_menu" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
