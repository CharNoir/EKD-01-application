<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CardContainer">

    <TextView style="@style/CardTitle" android:text="@string/gps_section_title" />
    <TextView android:id="@+id/gpsInfo" style="@style/BodyText" />
    <TextView android:id="@+id/gpsHint" style="@style/HintText" android:visibility="gone" />
    <LinearLayout
        android:id="@+id/gpsColorToggle"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_bg"
        android:padding="3dp"
        android:visibility="gone">
        <Button
            android:id="@+id/gpsColorPlainBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/gps_color_plain" />
        <Button
            android:id="@+id/gpsColorSpeedBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:text="@string/gps_color_speed" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/gpsMapHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/gpsLegend"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/gpsSpeedLegend"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone">
        <View
            android:id="@+id/gpsSpeedBar"
            android:layout_width="match_parent"
            android:layout_height="10dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView android:id="@+id/gpsSpeedMin" style="@style/HintText" android:layout_width="0dp" android:layout_weight="1" />
            <TextView android:id="@+id/gpsSpeedMax" style="@style/HintText" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
    <Button
        android:id="@+id/gpsExportBtn"
        style="@style/AmberButton"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="@string/gps_export_ride" />
</LinearLayout>
