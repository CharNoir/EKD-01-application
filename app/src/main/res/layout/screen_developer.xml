<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout style="@style/CardContainer">
            <Button android:id="@+id/backBtn" style="@style/AmberButton" android:text="@string/back" />
        </LinearLayout>

        <!-- Raw telemetry bytes: hunt ground for an undecoded speed field -->
        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/raw_telemetry_title" />
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/rawHexBtn" style="@style/AmberButton.Row" android:text="@string/raw_hex" />
                <Button android:id="@+id/rawDecimalBtn" style="@style/AmberButton.Row" android:text="@string/raw_decimal" />
            </LinearLayout>
            <TextView style="@style/HintText" android:paddingTop="8dp" android:text="@string/raw_t1_hint" />
            <TextView android:id="@+id/rawT1View" style="@style/MonoText" android:layout_width="match_parent" />
            <TextView style="@style/HintText" android:paddingTop="10dp" android:text="@string/raw_t9_hint" />
            <TextView android:id="@+id/rawT9View" style="@style/MonoText" android:layout_width="match_parent" />
        </LinearLayout>

        <!-- Assist level reporting analysis -->
        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/analysis_title" />
            <TextView style="@style/HintText" android:paddingBottom="6dp" android:text="@string/analysis_hint" />
            <TextView android:id="@+id/analysisView" style="@style/MonoText" android:layout_width="match_parent" />
            <Button android:id="@+id/analysisClearBtn" style="@style/AmberButton" android:layout_marginTop="8dp" android:text="@string/analysis_clear" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/cfg_read_title" />
            <TextView style="@style/HintText" android:text="@string/cfg_read_hint" />
            <Button android:id="@+id/readConfigBtn" style="@style/AmberButton" android:text="@string/cfg_read_btn" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navStartBtn"
                    style="@style/AmberButton.Row"
                    android:text="@string/nav_start" />

                <Button
                    android:id="@+id/navStopBtn"
                    style="@style/AmberButton.Row"
                    android:text="@string/nav_stop" />
            </LinearLayout>

            <TextView style="@style/CardTitle" android:text="@string/nav_update_title" />
            <EditText android:importantForAutofill="no" android:minHeight="48dp" android:id="@+id/tmpIconInput" style="@style/StyledEditText" android:hint="@string/hint_tmp_icon" android:inputType="number" />
            <EditText android:importantForAutofill="no" android:minHeight="48dp" android:id="@+id/curRetainInput" style="@style/StyledEditText" android:hint="@string/hint_cur_retain" android:inputType="number" />
            <EditText android:importantForAutofill="no" android:minHeight="48dp" android:id="@+id/nextStepDistInput" style="@style/StyledEditText" android:hint="@string/hint_next_step_dist" android:inputType="number" />
            <EditText android:importantForAutofill="no" android:minHeight="48dp" android:id="@+id/nextIconInput" style="@style/StyledEditText" android:hint="@string/hint_next_icon" android:inputType="number" />
            <EditText android:importantForAutofill="no" android:minHeight="48dp" android:id="@+id/nextNextStepDistInput" style="@style/StyledEditText" android:hint="@string/hint_next_next_step_dist" android:inputType="number" />
            <EditText android:importantForAutofill="no" android:minHeight="48dp" android:id="@+id/nextNextIconInput" style="@style/StyledEditText" android:hint="@string/hint_next_next_icon" android:inputType="number" />
            <EditText android:importantForAutofill="no" android:minHeight="48dp" android:id="@+id/pathRetainInput" style="@style/StyledEditText" android:hint="@string/hint_path_retain" android:inputType="number" />
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/navPresetBtn" style="@style/AmberButton.Row" android:text="@string/nav_preset" />
                <Button android:id="@+id/navSendBtn" style="@style/AmberButton.Row" android:text="@string/nav_send" />
            </LinearLayout>
            <TextView style="@style/HintText" android:paddingTop="4dp"
                android:text="@string/nav_icon_codes" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/log_title" />
            <CheckBox android:minHeight="48dp" android:id="@+id/telemetryLogCheckbox" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:text="@string/log_telemetry_checkbox" />
            <CheckBox android:minHeight="48dp" android:id="@+id/logHistoryCheckbox" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:text="@string/log_history_checkbox" />
            <androidx.core.widget.NestedScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:focusable="false"
                android:descendantFocusability="blocksDescendants"
                android:padding="6dp"
                android:background="@drawable/log_bg">
                <TextView
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary" />
            </androidx.core.widget.NestedScrollView>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/copyLogBtn" style="@style/AmberButton.Row" android:text="@string/copy_log" />
                <Button android:id="@+id/clearLogBtn" style="@style/AmberButton.Row" android:text="@string/clear_log" />
            </LinearLayout>
            <Button android:id="@+id/openLogHistoryBtn" style="@style/AmberButton" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="@string/log_history_open" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
