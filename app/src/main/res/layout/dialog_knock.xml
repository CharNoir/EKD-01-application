<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <EditText
        android:id="@+id/knockSequenceInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/knock_sequence_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:minHeight="48dp"
        android:singleLine="true" />
    <EditText
        android:id="@+id/knockGapInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/knock_gap_hint"
        android:inputType="number"
        android:singleLine="true" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="@string/knock_action_label" />
    <Spinner
        android:id="@+id/knockActionSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <EditText
        android:id="@+id/knockParamInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:inputType="text"
        android:singleLine="true" />
</LinearLayout>
