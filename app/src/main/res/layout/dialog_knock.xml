<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <TextView style="@style/SectionLabel" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="@string/knock_sequence_label" />
    <EditText
        android:id="@+id/knockSequenceInput"
        style="@style/StyledEditText"
        android:hint="@string/knock_sequence_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:minHeight="48dp" />

    <TextView style="@style/SectionLabel" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="@string/knock_gap_label" />
    <EditText
        android:id="@+id/knockGapInput"
        style="@style/StyledEditText"
        android:hint="@string/knock_gap_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:minHeight="48dp" />

    <TextView style="@style/SectionLabel" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="@string/knock_action_label" />
    <Spinner
        android:id="@+id/knockActionSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/input_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <EditText
        android:id="@+id/knockParamInput"
        style="@style/StyledEditText"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="48dp" />
</LinearLayout>
