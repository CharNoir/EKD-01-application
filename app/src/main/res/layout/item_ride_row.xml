<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/rideColor"
        android:layout_width="6dp"
        android:layout_height="40dp"
        android:background="@drawable/bar_bg" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView android:id="@+id/rideTitle" style="@style/BodyText" android:textStyle="bold" />
        <TextView android:id="@+id/rideSub" style="@style/HintText" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end">
        <TextView android:id="@+id/rideDist" style="@style/BodyText" android:textStyle="bold" />
        <TextView android:id="@+id/rideStats" style="@style/HintText" />
    </LinearLayout>
</LinearLayout>
