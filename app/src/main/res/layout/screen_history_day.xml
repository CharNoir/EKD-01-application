<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView android:id="@+id/dayTitle" style="@style/PageTitle" />
        <TextView
            android:id="@+id/daySubtitle"
            style="@style/HintText"
            android:paddingStart="6dp"
            android:paddingBottom="10dp" />
        <TextView
            android:id="@+id/dayEmpty"
            style="@style/HintText"
            android:visibility="gone"
            android:paddingStart="6dp"
            android:text="@string/gps_day_empty" />

        <LinearLayout
            android:id="@+id/dayGpsContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout style="@style/HeroBox">
            <TextView style="@style/TileLabel" android:textSize="11sp" android:text="@string/day_total" />
            <TextView android:id="@+id/dayDistance" style="@style/BigNumber" android:layout_marginTop="4dp" />
            <LinearLayout
                android:id="@+id/dayTotalTiles"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="-3dp"
                android:layout_marginEnd="-3dp" />
            <TextView
                android:id="@+id/dayCharged"
                style="@style/HintText"
                android:textColor="@color/amber"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                android:text="@string/day_charged" />
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="@string/day_timeline" />
        <LinearLayout style="@style/CardContainer">
            <com.char_noir.ekd01.TimelineView
                android:id="@+id/dayTimeline"
                android:layout_width="match_parent"
                android:layout_height="52dp" />
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="@string/day_rides" />
        <LinearLayout
            android:id="@+id/dayRides"
            style="@style/Group"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <LinearLayout
            android:id="@+id/dayChartContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
