<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView android:id="@+id/detailTitle" style="@style/PageTitle" />
        <TextView
            android:id="@+id/detailSubtitle"
            style="@style/HintText"
            android:paddingStart="6dp"
            android:paddingBottom="10dp" />

        <LinearLayout style="@style/HeroBox">
            <TextView android:id="@+id/detailDistance" style="@style/BigNumber" />
            <LinearLayout
                android:id="@+id/detailTiles"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="-3dp"
                android:layout_marginEnd="-3dp" />
            <TextView
                android:id="@+id/detailCharged"
                style="@style/HintText"
                android:textColor="@color/amber"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gpsContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView style="@style/SectionLabel" android:text="@string/charts_title" />
        <LinearLayout
            android:id="@+id/chartList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout style="@style/CardContainer">
            <TextView style="@style/CardTitle" android:text="@string/history_samples_title" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:id="@+id/detailSamples" style="@style/MonoText" />
            </HorizontalScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
