<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:padding="14dp">

    <!-- Top bar: connection button (gray / amber / green, tap to connect or disconnect) and battery pill -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/connectionIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_bluetooth"
            app:tint="@color/neutral"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/cd_connection" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/pill_bg">

            <TextView
                android:id="@+id/batteryPercentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp"
                android:text="@string/battery_percent_unknown" />

            <FrameLayout
                android:id="@+id/batteryIconFrame"
                android:layout_width="26dp"
                android:layout_height="14dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/battery_outline" />
                <ImageView
                    android:id="@+id/batteryFillImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:src="@drawable/battery_fill_clip"
                    android:contentDescription="@string/cd_battery_level" />
            </FrameLayout>

            <View
                android:id="@+id/batteryNub"
                android:layout_width="2dp"
                android:layout_height="6dp"
                android:layout_marginStart="2dp"
                android:background="@color/text_hint" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Speed: as big as fits (shrinks automatically for long values) -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <TextView
            android:id="@+id/speedValueLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/placeholder_dash"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="150sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="60sp"
            android:autoSizeMaxTextSize="170sp"
            android:autoSizeStepGranularity="2sp" />

        <TextView
            android:id="@+id/speedUnitLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_unit"
            android:textSize="14sp"
            android:letterSpacing="0.15"
            android:textColor="@color/text_hint" />
    </LinearLayout>

    <!-- Trip stats strip -->
    <LinearLayout
        android:id="@+id/tripStatsBar"
        style="@style/CardContainer"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="16dp">

        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_distance" android:textSize="10sp" android:textColor="@color/text_hint" android:textAllCaps="true" />
            <TextView android:id="@+id/tripDistLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_dash" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_time" android:textSize="10sp" android:textColor="@color/text_hint" android:textAllCaps="true" />
            <TextView android:id="@+id/tripTimeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_dash" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_avg" android:textSize="10sp" android:textColor="@color/text_hint" android:textAllCaps="true" />
            <TextView android:id="@+id/tripAvgLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_dash" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_max" android:textSize="10sp" android:textColor="@color/text_hint" android:textAllCaps="true" />
            <TextView android:id="@+id/tripMaxLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_dash" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/amber" />
        </LinearLayout>
    </LinearLayout>

    <!-- Assist level: big minus / plus, the level in the middle with 5 small bars -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/assistMinusBtn"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:textSize="38sp"
            android:textColor="@color/text_primary"
            android:text="@string/glyph_minus"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/step_btn"
            android:contentDescription="@string/cd_assist_decrease" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/assist_label" android:textSize="11sp" android:letterSpacing="0.1" android:textColor="@color/text_hint" android:textAllCaps="true" />
            <TextView
                android:id="@+id/assistLevelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="54sp"
                android:textStyle="bold"
                android:textColor="@color/amber"
                android:includeFontPadding="false"
                android:text="@string/placeholder_dash" />
            <LinearLayout
                android:id="@+id/assistBars"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <View android:layout_width="22dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:background="@drawable/bar_bg" />
                <View android:layout_width="22dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:background="@drawable/bar_bg" />
                <View android:layout_width="22dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:background="@drawable/bar_bg" />
                <View android:layout_width="22dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:background="@drawable/bar_bg" />
                <View android:layout_width="22dp" android:layout_height="6dp" android:background="@drawable/bar_bg" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/assistPlusBtn"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:textSize="38sp"
            android:textColor="@color/text_primary"
            android:text="@string/glyph_plus"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/step_btn"
            android:contentDescription="@string/cd_assist_increase" />
    </LinearLayout>

    <!-- Bottom row: settings, odometer, headlight -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/settingsIconBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/neutral"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/cd_settings" />

        <ImageView
            android:id="@+id/historyIconBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:padding="13dp"
            android:src="@drawable/ic_history"
            app:tint="@color/neutral"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/cd_history" />

        <TextView
            android:id="@+id/odoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/odo_unknown"
            android:textSize="13sp"
            android:textColor="@color/text_hint" />

        <ImageView
            android:id="@+id/lightIconBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:src="@drawable/ic_headlight"
            app:tint="@color/neutral"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/round_btn"
            android:contentDescription="@string/cd_toggle_light" />
    </LinearLayout>

</LinearLayout>
