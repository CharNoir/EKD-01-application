<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout style="@style/CardContainer">
            <Button android:id="@+id/backBtn" style="@style/AmberButton" android:text="@string/back" />
        </LinearLayout>

        <LinearLayout style="@style/CardContainer">

            <Button
                android:id="@+id/newKnockBtn"
                style="@style/AmberButton"
                android:layout_width="match_parent"
                android:text="@string/knock_new" />
        </LinearLayout>

        <TextView style="@style/CardTitle" android:paddingStart="4dp" android:text="@string/knocks_title" />
        <TextView
            style="@style/HintText"
            android:paddingStart="4dp"
            android:paddingBottom="8dp"
            android:text="@string/knocks_screen_hint" />
        <TextView
            android:id="@+id/knocksEmpty"
            style="@style/HintText"
            android:visibility="gone"
            android:paddingStart="4dp"
            android:paddingBottom="8dp"
            android:text="@string/knocks_empty" />

        <LinearLayout
            android:id="@+id/knockList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
