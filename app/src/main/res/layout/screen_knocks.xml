<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView style="@style/PageTitle" android:text="@string/knocks_title" />
        <TextView
            style="@style/HintText"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp"
            android:text="@string/knocks_screen_hint" />

        <Button
            android:id="@+id/newKnockBtn"
            style="@style/AmberButton"
            android:layout_width="match_parent"
            android:text="@string/knock_new" />

        <LinearLayout style="@style/Group" android:layout_marginTop="12dp">
            <LinearLayout style="@style/SettingRow">
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/knocksRejectAmbiguous"
                    style="@style/AppSwitch"
                    android:text="@string/knocks_reject_ambiguous" />
                <TextView style="@style/HintText" android:text="@string/knocks_reject_ambiguous_hint" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/knocksEmpty"
            style="@style/HintText"
            android:visibility="gone"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="12dp"
            android:text="@string/knocks_empty" />

        <LinearLayout
            android:id="@+id/knockList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
