<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout style="@style/CardContainer">
            <Button android:id="@+id/backBtn" style="@style/AmberButton" android:text="@string/back" />
        </LinearLayout>

        <TextView style="@style/CardTitle" android:paddingStart="4dp" android:text="@string/history_title" />
        <TextView
            android:id="@+id/historyBike"
            style="@style/BodyText"
            android:visibility="gone"
            android:paddingStart="4dp"
            android:paddingBottom="8dp" />
        <TextView
            android:id="@+id/historyEmpty"
            style="@style/HintText"
            android:visibility="gone"
            android:paddingStart="4dp"
            android:paddingBottom="8dp"
            android:text="@string/history_empty" />

        <LinearLayout
            android:id="@+id/historyList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
